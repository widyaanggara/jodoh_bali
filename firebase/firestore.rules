rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Append-only form logs; anonymous CREATE explicitly approved by product owner.
    match /daily_logs/{logId} {
      function calendarDate(s) {
        let p = s.split('-');
        let t = timestamp.date(int(p[0]), int(p[1]), int(p[2]));
        return t.year() == int(p[0]) && t.month() == int(p[1]) && t.day() == int(p[2]);
      }
      function validDate(s) {
        return s is string && s.matches('^(19|20)[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$') && calendarDate(s);
      }
      function validTime(s) {
        return s == null || (s is string && s.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'));
      }
      function validRange(p) {
        return p.start_year is int && p.end_year is int
          && p.start_year >= 1900 && p.end_year <= 2100 && p.start_year <= p.end_year;
      }
      function validSearch(d) {
        return (d.feature_type == 'mencari_jodoh'
          && d.search_input is map && d.search_input.keys().hasAll(['start_year','end_year'])
          && d.search_input.keys().hasOnly(['start_year','end_year']) && validRange(d.search_input))
          || (d.feature_type != 'mencari_jodoh' && !('search_input' in d));
      }
      function validLog() {
        let d = request.resource.data;
        let pair = d.feature_type in ['kecocokan_pasangan','ramalan_pernikahan','samyoga'];
        return logId.matches('^[A-Za-z0-9]{20}$')
          && d.keys().hasAll(['session_id','feature_type','tanggal_lahir','tanggal_lahir_2','jam_lahir','jam_lahir_2','created_at','consent_granted','consent_version'])
          && d.keys().hasOnly(['session_id','feature_type','tanggal_lahir','tanggal_lahir_2','jam_lahir','jam_lahir_2','created_at','consent_granted','consent_version','search_input'])
          && d.session_id is string && d.session_id.matches('^[A-Z0-9]{9,10}$')
          && d.feature_type in ['kecocokan_pasangan','mencari_jodoh','ramalan_pernikahan','ramalan_otonan','samyoga','netra_hasta']
          && validDate(d.tanggal_lahir)
          && ((pair && validDate(d.tanggal_lahir_2)) || (!pair && d.tanggal_lahir_2 == null && d.jam_lahir_2 == null))
          && validTime(d.jam_lahir) && validTime(d.jam_lahir_2)
          && validSearch(d)
          && d.consent_granted == true && d.consent_version == 'metemu-activity-v1'
          && d.created_at == request.time;
      }
      allow create: if validLog();
      allow get, list, update, delete: if false;
    }

    match /netraHastaUsers/{uid}/results/{recordId} {
      function owner() { return request.auth != null && request.auth.uid == uid; }
      function validCreate() {
        let d = request.resource.data;
        return d.keys().hasAll(['schemaVersion','ownerUid','birthDate','birthTime','saptawara','pancawara','wuku','lintang','rekhaStatus','rekhaSource','rekhaClasses','algorithmVersion','calendarVersion','consentVersion','savedAt'])
          && d.keys().hasOnly(['schemaVersion','ownerUid','birthDate','birthTime','saptawara','pancawara','wuku','lintang','rekhaStatus','rekhaSource','rekhaClasses','algorithmVersion','calendarVersion','consentVersion','savedAt','detailSnapshot'])
          && recordId.matches('^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$')
          && d.schemaVersion in ['netra-history-v1','netra-history-v2'] && d.ownerUid == uid
          && ((d.schemaVersion == 'netra-history-v1' && !('detailSnapshot' in d))
              || (d.schemaVersion == 'netra-history-v2' && d.detailSnapshot is string && d.detailSnapshot.size() <= 48000))
          && d.birthDate is string && d.birthDate.matches('^(19|20)[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
          && d.birthTime is string && (d.birthTime == '' || d.birthTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'))
          && d.saptawara is string && d.saptawara.size() <= 80
          && d.pancawara is string && d.pancawara.size() <= 80
          && d.wuku is string && d.wuku.size() <= 80
          && d.lintang is string && d.lintang.size() <= 100
          && d.rekhaStatus in ['automatic_candidate','uncertain']
          && d.rekhaSource == 'browser-automatic-unvalidated' && d.rekhaClasses == 'unsupported'
          && d.algorithmVersion == 'dark-ridge-v1' && d.calendarVersion == 'calendar-web-8d154cb'
          && d.consentVersion == 'netra-history-until-deleted-v1'
          && d.savedAt == request.time;
      }
      allow get, list: if owner();
      allow create: if owner() && validCreate();
      allow update: if false;
      allow delete: if owner() && resource.data.ownerUid == uid;
    }
  }
}
